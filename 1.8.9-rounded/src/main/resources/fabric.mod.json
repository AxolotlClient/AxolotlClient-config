{
  "schemaVersion": 1,
  "id": "axolotlclientconfig-rounded",
  "version": "${version}",
  "name": "AxolotlClientConfig (Rounded Style)",
  "description": "Config Library for AxolotlClient (Rounded Style)",
  "authors": [
    "moehreag"
  ],
  "contact": {
    "homepage": "https://axolotlclient.com/",
    "sources": "https://github.com/AxolotlClient/AxolotlClient-config"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/axolotlclientconfig/icon.png",
  "environment": "client",
  "entrypoints": {
    "client-init": [
      "io.github.axolotlclient.AxolotlClientConfig.impl.AxolotlClientConfigRoundedStyleMod"
    ]
  },
  "mixins": [
    "axolotlclientconfig-rounded.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "1.8.9",
    "osl-resource-loader": "*",
    "osl-lifecycle-events": "*",
    "osl-keybinds": "*",
    "osl-entrypoints": "*",
    "legacy-lwjgl3": ">=1.2.0"
  }
}
